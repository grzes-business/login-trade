---
import Layout from "../layouts/Layout.astro";

const site = {
  businessName: "Logintrade",
  heroHeadline: "Platforma zakupowa, sprzedażowa i przetargowa – Logintrade",
  ctaLink: "https://www.logintrade.pl",
  services: [
    {
      title: "Zapotrzebowania",
      description:
        "Narzędzia e-procurement do składania, weryfikacji i akceptacji wewnętrznych potrzeb zakupowych w firmie.",
      icon: "clipboard-check",
    },
    {
      title: "Zapytania ofertowe (RFX)",
      description:
        "Intuicyjne tworzenie zapytań RFI, RFP, RFQ oraz analiza ofert handlowych od dostawców.",
      icon: "file-question",
    },
    {
      title: "Aukcje elektroniczne",
      description:
        "Skuteczne negocjacje on-line w formatach angielskim, holenderskim i japońskim dla optymalizacji kosztów.",
      icon: "gavel",
    },
    {
      title: "Katalogi i zamówienia",
      description:
        "Wizualizacja produktów i moduł akceptacji koszyków ułatwiający realizację zakupów biznesowych.",
      icon: "shopping-cart",
    },
    {
      title: "Zarządzanie umowami",
      description:
        "Moduł e-Kontrakt zapewniający archiwizację, monitoring realizacji i łatwy dostęp do umów handlowych.",
      icon: "file-text",
    },
    {
      title: "Ocena dostawców",
      description:
        "Budowanie bazy know-how i zarządzanie procesem kwalifikacji oraz rozwoju dostawców.",
      icon: "user-check",
    },
    {
      title: "Szkolenia i Konsulting",
      description:
        "Wsparcie wdrożeniowe, audyt procesów zakupowych oraz warsztaty z zakresu e-procurement.",
      icon: "graduation-cap",
    },
  ],
  contact: {
    address: "ul. Legnicka 57D lok. B/J, 54-203 Wrocław",
    phone: "+48 71 787 35 34",
    email: "kontakt@logintrade.pl",
  },
};

const phoneHref = `tel:${site.contact.phone.replace(/\s+/g, "")}`;

const iconSymbols: Record<string, string> = {
  "clipboard-check": "✓",
  "file-question": "?",
  gavel: "⚖",
  "shopping-cart": "🛒",
  "file-text": "📄",
  "user-check": "👤",
  "graduation-cap": "🎓",
};
---

<Layout title="Logintrade">
  <main class="min-h-screen bg-white font-sans text-slate-900">
    <section class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-[#0076B3]">
        {site.businessName}
      </p>
      <h1 class="max-w-4xl text-3xl font-bold leading-tight md:text-5xl">
        {site.heroHeadline}
      </h1>
      <div class="mt-8">
        <a
          href={site.ctaLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex border border-[#0076B3] bg-[#0076B3] px-6 py-3 font-semibold text-white transition hover:bg-transparent hover:text-[#0076B3]"
          >Odwiedź Logintrade</a
        >
      </div>
    </section>

    <section class="bg-slate-50">
      <div class="mx-auto max-w-6xl px-6 py-14 md:py-20">
        <h2 class="mb-8 text-2xl font-bold">Usługi</h2>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {
            site.services.map((service) => (
              <article class="border border-slate-200 bg-white p-5">
                <div
                  class="mb-3 inline-flex h-8 w-8 items-center justify-center border border-[#0076B3] text-sm font-bold text-[#0076B3]"
                  aria-hidden="true"
                >
                  <span>{iconSymbols[service.icon]}</span>
                </div>
                <h3 class="mb-2 text-lg font-semibold">{service.title}</h3>
                <p class="text-sm leading-relaxed text-slate-700">{service.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-14">
      <h2 class="mb-6 text-2xl font-bold">Kontakt</h2>
      <div class="grid gap-3 text-sm md:grid-cols-3 md:text-base">
        <p class="border border-[#B2B2B2] p-4">{site.contact.address}</p>
        <a class="border border-[#B2B2B2] p-4 hover:text-[#0076B3]" href={phoneHref}>
          {site.contact.phone}
        </a>
        <a
          class="border border-[#B2B2B2] p-4 hover:text-[#0076B3]"
          href={`mailto:${site.contact.email}`}
        >
          {site.contact.email}
        </a>
      </div>
    </section>
  </main>
</Layout>
